# INGESTION_SOURCE options: cloudwatch, webhook
INGESTION_SOURCE=webhook

AWS_REGION=us-east-1
EC2_INSTANCE_IDS=
CLOUDWATCH_PERIOD_SECONDS=300

DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Requests per minute per client IP (0 disables)
RATE_LIMIT_PER_MINUTE=300
# Only set true behind a trusted reverse proxy such as the bundled Caddy
TRUST_PROXY_HEADERS=false

SLACK_WEBHOOK_URL=
ALERT_COOLDOWN_SECONDS=900

WEIGHT_ISOLATION_FOREST=0.25
WEIGHT_LSTM_AE=0.45
WEIGHT_VAE=0.30
WEIGHT_TRANSFORMER=0.30
ANOMALY_THRESHOLD=0
CRITICAL_SCORE=0.85

RETENTION_DAYS=30
HTTP_BIND=80
DOMAIN=
