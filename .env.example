# INGESTION_SOURCE options: mock, cloudwatch, webhook
INGESTION_SOURCE=webhook

AWS_REGION=us-east-1
EC2_INSTANCE_IDS=
CLOUDWATCH_PERIOD_SECONDS=300

DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Shared secret agents send as X-API-Key. Generate with: openssl rand -hex 32
INGEST_API_KEY=
# Requests per minute per client IP (0 disables)
RATE_LIMIT_PER_MINUTE=300
# Only set true behind a trusted reverse proxy such as the bundled Caddy
TRUST_PROXY_HEADERS=false

# Active defense: off | dry_run | enforce
DEFENSE_MODE=dry_run
# auto | iptables | nftables | pfctl
DEFENSE_FIREWALL=auto
DEFENSE_BLOCK_SECONDS=300
DEFENSE_SAFE_MODE_SECONDS=60
# Comma separated IPs/CIDRs that are never blocked (add your proxy, admin and monitoring addresses)
DEFENSE_ALLOWLIST=127.0.0.1,::1

SLACK_WEBHOOK_URL=
ALERT_COOLDOWN_SECONDS=900

WEIGHT_ISOLATION_FOREST=0.25
WEIGHT_LSTM_AE=0.45
WEIGHT_VAE=0.30
ANOMALY_THRESHOLD=0
CRITICAL_SCORE=0.85

RETENTION_DAYS=30
HTTP_BIND=80
DOMAIN=
