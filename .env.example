# install.sh writes .env for you and keeps what is already there on a re-run.

# INGESTION_SOURCE options: webhook (agents, the default), cloudwatch (optional, needs AWS)
INGESTION_SOURCE=webhook

# Only for INGESTION_SOURCE=cloudwatch; see deploy/cloudwatch-agent.json and deploy/latency_probe.sh
AWS_REGION=us-east-1
EC2_INSTANCE_IDS=
CLOUDWATCH_PERIOD_SECONDS=300

DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Requests per minute per client IP (0 disables)
RATE_LIMIT_PER_MINUTE=300
# Only set true behind a trusted reverse proxy such as the bundled Caddy
TRUST_PROXY_HEADERS=false

SLACK_WEBHOOK_URL=
ALERT_COOLDOWN_SECONDS=900

WEIGHT_ISOLATION_FOREST=0.25
WEIGHT_LSTM_AE=0.45
WEIGHT_VAE=0.30
WEIGHT_TRANSFORMER=0.30
ANOMALY_THRESHOLD=0
CRITICAL_SCORE=0.85

RETENTION_DAYS=30

# Default storage is SQLite in the data volume. For more servers: postgresql+psycopg://user:pass@host/nexus
DATABASE_URL=

# With a domain: Caddy serves HTTPS on 80/443 and nexus is not published.
#   DOMAIN=nexus.example.com
#   PUBLIC_URL=https://nexus.example.com
#   TRUST_PROXY_HEADERS=true
#   COMPOSE_PROFILES=https
# PUBLIC_URL is the address embedded in /install-agent.sh. Empty means the installer needs --url.
DOMAIN=
PUBLIC_URL=

# Without a domain: nexus listens on loopback only, reach it over an SSH tunnel.
HTTP_BIND=127.0.0.1:8000
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
